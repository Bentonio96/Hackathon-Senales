# Copia este archivo a .env.local y completa los valores tú mismo.
# Nunca subas .env.local al repo.

ANTHROPIC_API_KEY=
# Modelo de Amy. Por defecto claude-haiku-5-5 (barato, para probar).
# Para el pitch: claude-opus-5-5
AMI_MODELO=

# Twilio, sandbox de WhatsApp (Console > Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública exacta configurada en el sandbox (para validar la firma de Twilio).
# Ejemplo: https://ami.vercel.app/api/whatsapp
TWILIO_WEBHOOK_URL=
# Solo para pruebas locales con un túnel: 1 desactiva la validación de firma.
TWILIO_SKIP_VALIDATION=

# Opcional: Upstash Redis (Vercel Marketplace). Sin esto, el estado vive en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: clave de USDA FoodData Central (sin ella se usa DEMO_KEY, con límite bajo).
FDC_API_KEY=

# Opcional, para el pitch: el celular al que el reloj de /demo manda los mensajes de Amy.
# Formato: whatsapp:+569XXXXXXXX. Si no está, se usa el último número que le escribió a Amy.
DEMO_WHATSAPP_NUMERO=
